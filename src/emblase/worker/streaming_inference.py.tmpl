"""Streaming inference script — runs on the compute node inside `pixi run python`.

Filled by _render_streaming_inference_script():
    {{models_dir}}     — absolute path to the models directory on the compute node
    {{model_name}}     — short name ("vae", "vit") or MLflow registry name
    {{batch_size}}     — number of frames per encode call
    {{run_path}}       — Tiled path to the BlueskyRun to watch (e.g. smi/.../run_xyz)
    {{output}}         — Tiled container path to write embeddings
    {{mlflow_version}} — MLflow model version, or "" for latest
    {{thumb_mode}}     — thumbnail mode ("default" or "logroi")
    {{image_key}}      — key of the image array within the primary stream
    {{ws_max_size}}    — WebSocket max message size in bytes

Flow:
  1. Load model and connect to Tiled.
  2. Subscribe to the run container (replay) → wait for primary stream.
  3. Subscribe to primary (replay) → wait for the image array.
  4. Subscribe to image array (replay) → accumulate frames; enqueue full batches
     to the writer thread for encoding + writing.
  5. Subscribe to parent container (replay) → detect stop document.
  6. On stop doc: poll until _next_frame_idx stabilises (image WS has gone quiet),
     flush remaining frames, send sentinel to writer thread, wait for it to exit.
"""

import logging
import os
import queue
import sys
import threading
import time

import numpy as np
import torch

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
    stream=sys.stdout,
    force=True,
)
log = logging.getLogger("emblase.streaming_inference")

# --- job parameters (substituted by _render_streaming_inference_script) ---
job_dir        = os.environ["JOB_DIR"]
model_name     = "{model_name}"
batch_size     = {batch_size}
run_path       = "{run_path}"
output         = "{output}"
mlflow_version = "{mlflow_version}" or None
thumb_mode     = "{thumb_mode}"
image_key      = "{image_key}"
ws_max_size    = {ws_max_size}

_raw_tags = os.environ.get("EMBLASE_TILED_ACCESS_TAGS", "").strip()
access_tags: list[str] | None = [t.strip() for t in _raw_tags.split(",") if t.strip()] or None

log.info("=== Emblase streaming inference job ===")
log.info("job_dir    : %s", job_dir)
log.info("model      : %s", model_name)
log.info("run_path   : %s", run_path)
log.info("output     : %s", output)
log.info("batch_size : %d", batch_size)
log.info("thumb_mode : %s", thumb_mode)
log.info("image_key  : %s", image_key)
log.info("access_tags: %s", access_tags)

models_dir = "{models_dir}"
if models_dir not in sys.path:
    sys.path.insert(0, models_dir)

from emblase.models import encode, load_model  # noqa: E402

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
log.info("device     : %s", device)
if device.type == "cuda":
    log.info("GPU        : %s", torch.cuda.get_device_name(device))

log.info("Loading model %r ...", model_name)
t0 = time.perf_counter()
model = load_model(
    model_name,
    mlflow_version=mlflow_version,
    mlflow_tracking_uri=os.environ.get("EMBLASE_MLFLOW_TRACKING_URI") or None,
    mlflow_api_key=os.environ.get("EMBLASE_MLFLOW_API_KEY") or None,
)
log.info("Model loaded in %.1f s", time.perf_counter() - t0)

from tiled.client import from_uri  # noqa: E402
from emblase.tiled.client import write_output  # noqa: E402

tiled_server = os.environ["EMBLASE_TILED_SERVER_URI"]
log.info("Connecting to Tiled: %s", tiled_server)
tiled_client = from_uri(tiled_server, api_key=os.environ.get("EMBLASE_TILED_API_KEY") or None)

run_segments = [s for s in run_path.split("/") if s]
run_node = tiled_client[tuple(run_segments)]
log.info("Run node: %s", run_path)

# ---------------------------------------------------------------------------
# Writer thread — serialises all encode+write work through a queue.
# Items: (frames: list[ndarray], entries: list[tuple]) or None (sentinel).
# ---------------------------------------------------------------------------
_write_queue: queue.Queue = queue.Queue()
_done = threading.Event()       # set when writer exits (cleanly or on error)
_writer_error: BaseException | None = None


def _writer_loop() -> None:
    global _writer_error
    try:
        while True:
            item = _write_queue.get()
            try:
                if item is None:
                    log.info("Writer thread: sentinel received — exiting")
                    return
                frames, entries = item
                t0 = time.perf_counter()
                embeddings = encode(model, frames, batch_size=1)
                log.info("Encoded %d frame(s) in %.1f s → shape %s",
                         len(frames), time.perf_counter() - t0, embeddings.shape)
                write_output(
                    tiled_client, output, embeddings,
                    images=frames, source_entries=entries,
                    model_name=model_name, thumb_mode=thumb_mode, access_tags=access_tags,
                )
                log.info("Written to Tiled: %s", output)
            finally:
                _write_queue.task_done()
    except Exception as exc:
        _writer_error = exc
        log.exception("Writer thread failed: %s", exc)
    finally:
        _done.set()


threading.Thread(target=_writer_loop, name="emblase-writer", daemon=True).start()

# --- frame accumulation state (accessed from image WS thread + stop-doc thread) ---
_lock = threading.Lock()
_queued_frames: list[np.ndarray] = []
_queued_entries: list[tuple] = []
_next_frame_idx = 0


def _maybe_flush_batch() -> None:
    """If the queue has grown to batch_size, drain it and enqueue for writing.
    Must be called with _lock held."""
    if len(_queued_frames) >= batch_size:
        _write_queue.put((list(_queued_frames), list(_queued_entries)))
        _queued_frames.clear()
        _queued_entries.clear()


def _on_new_image_data(event) -> None:
    global _next_frame_idx
    chunk = event.data()  # (n, C, H, W)
    n = chunk.shape[0]
    log.info("Received %d frame(s) (idx %d–%d)", n, _next_frame_idx, _next_frame_idx + n - 1)
    with _lock:
        for i in range(n):
            _queued_frames.append(chunk[i].squeeze())  # (H, W)
            _queued_entries.append((run_path + f"/primary/{{image_key}}", str(_next_frame_idx)))
            _next_frame_idx += 1
        _maybe_flush_batch()


def _on_image_child_created(event) -> None:
    if event.key == image_key:
        log.info("Image array %r appeared — subscribing", image_key)
        sub = event.child().subscribe()
        sub.new_data.add_callback(_on_new_image_data)
        _all_subs.append(sub)
        sub.start_in_thread(start=1, max_size=ws_max_size)


def _on_run_child_created(event) -> None:
    if event.key == "primary":
        log.info("primary stream appeared — subscribing")
        sub = event.child().subscribe()
        sub.child_created.add_callback(_on_image_child_created)
        _all_subs.append(sub)
        sub.start_in_thread(start=1)


def _on_stop_doc(event) -> None:
    if event.key != run_segments[-1] or "stop" not in (event.metadata or {{}}):
        return
    log.info("Stop doc received — waiting for image WS to settle")
    # The stop doc and image frames arrive on two independent WS connections;
    # poll until _next_frame_idx is stable for 2 s (WS replay has finished).
    _STABLE_SECS = 2.0
    _MAX_WAIT_SECS = 120.0
    deadline = time.monotonic() + _MAX_WAIT_SECS
    last_idx, stable_since = -1, time.monotonic()
    while time.monotonic() < deadline:
        time.sleep(0.2)
        with _lock:
            cur = _next_frame_idx
        if cur != last_idx:
            last_idx, stable_since = cur, time.monotonic()
        elif time.monotonic() - stable_since >= _STABLE_SECS:
            break
    log.info("Settled at %d frame(s) — flushing remainder", last_idx)
    with _lock:
        remaining = list(_queued_frames), list(_queued_entries)
        _queued_frames.clear()
        _queued_entries.clear()
    if remaining[0]:
        log.info("Flushing %d remaining frame(s)", len(remaining[0]))
        _write_queue.put(remaining)
    _write_queue.put(None)  # sentinel


_all_subs: list = []

run_sub = run_node.subscribe()
run_sub.child_created.add_callback(_on_run_child_created)
_all_subs.append(run_sub)
run_sub.start_in_thread(start=1)

parent_node = tiled_client[tuple(run_segments[:-1])]
parent_sub = parent_node.subscribe()
parent_sub.child_metadata_updated.add_callback(_on_stop_doc)
_all_subs.append(parent_sub)
parent_sub.start_in_thread(start=1)

log.info("Watching run %s — waiting for stop document ...", run_path)

_done.wait(timeout=7200)  # 2-hour hard limit

if not _done.is_set():
    log.warning("Timeout reached — flushing and exiting")
    with _lock:
        remaining = list(_queued_frames), list(_queued_entries)
        _queued_frames.clear()
        _queued_entries.clear()
    if remaining[0]:
        _write_queue.put(remaining)
    _write_queue.put(None)
    _write_queue.join()

for sub in _all_subs:
    try:
        sub.disconnect()
    except Exception:
        pass

log.info("=== Streaming inference done ===")

if _writer_error:
    log.error("Exiting with error due to writer thread failure")
    sys.exit(1)
