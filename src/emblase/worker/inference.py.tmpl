"""Inference script — runs on the compute node inside `pixi run python`.

Filled by _render_inference_script():
    {models_dir}        — absolute path to the models directory on the compute node
    {model_name}        — short name ("vae", "vit") or MLflow registry name
    {batch_size}        — number of images per encode call (default 1)
    {run_path}          — Tiled path to a BlueskyRun container; when non-empty the
                          image array is read as run_path/<image_stream>/<image_array_key>
                          and param arrays are sliced from the same stream.
                          Mutually exclusive with inputs.
     {image_key}         — slash-separated key of the image array, e.g. "primary/pil900KW_image"
    {inputs}            — repr of list[str | tuple[str,str]] of Tiled (path[, slice])
                          entries; used when run_path is empty (legacy raw-entry mode).
    {output}            — Tiled path to write embeddings (empty → output.npy).  Behaviour:
                          • path is an LSE container → append to it;
                          • path doesn't exist        → create LSE there;
                          • path is a non-LSE parent  → create {{run_key}}_batch_{{ts}} inside it.
    {mlflow_version}    — MLflow model version, or "" for latest
    {thumb_mode}        — thumbnail mode ("default" or "logroi")
    {param_specs_json}  — JSON dict mapping param name → ParamSpec
    {projector_mode}    — one of: "name" | "scratch" | "false"
    {projector_name}    — projector model name when projector_mode=="name", else ""
    {classifier_name}   — classifier model name, or "" to skip classification

Projector behaviour:
    projector_mode="name"    — resolve saved approximator; apply after encoding.
    projector_mode="scratch" — fit a fresh UMAP over all embeddings at the end.
    projector_mode="false"   — skip; write NaN projections.
"""

import json
import logging
import os
import sys
import time

import numpy as np
import torch

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
    stream=sys.stdout,
    force=True,
)
log = logging.getLogger("emblase.inference")

# --- job parameters (substituted at render time) ---
job_dir         = os.environ["JOB_DIR"]
model_name      = "{model_name}"
batch_size      = {batch_size}
run_path        = "{run_path}"
image_key       = "{image_key}"
inputs          = {inputs}
output          = "{output}"
mlflow_version  = "{mlflow_version}" or None
thumb_mode      = "{thumb_mode}"
param_specs     = json.loads('{param_specs_json}')
projector_mode  = "{projector_mode}"   # "name" | "scratch" | "false"
projector_name  = "{projector_name}"
classifier_name = "{classifier_name}"
models_dir      = "{models_dir}"

# Resolve image_key → (stream, array_key)
_ik = image_key.split("/", 1)
image_stream    = _ik[0] if len(_ik) == 2 else "primary"
image_array_key = _ik[1] if len(_ik) == 2 else _ik[0]

_raw_tags = os.environ.get("EMBLASE_TILED_ACCESS_TAGS", "").strip()
access_tags: list[str] | None = [t.strip() for t in _raw_tags.split(",") if t.strip()] or None

log.info("=== Emblase inference job ===")
log.info("job_dir    : %s", job_dir)
log.info("model      : %s  ver=%s", model_name, mlflow_version or "latest")
log.info("batch_size : %d  thumb_mode=%s", batch_size, thumb_mode)
log.info("run_path   : %s", run_path or "(none)")
log.info("image_key  : %s  (stream=%r  array=%r)", image_key, image_stream, image_array_key)
log.info("output     : %s", output or "(none — saving output.npy)")
log.info("access_tags: %s", access_tags or "(none)")
log.info("param_specs: %s", list(param_specs.keys()))
log.info("projector  : mode=%s  name=%r", projector_mode, projector_name or "(n/a)")
log.info("classifier : %s", classifier_name or "(none)")

if models_dir not in sys.path:
    sys.path.insert(0, models_dir)

from emblase.models import encode, load_model  # noqa: E402
from emblase.worker.utils import load_classifier_dir, load_projector  # noqa: E402

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
log.info("device: %s%s", device, f"  GPU={{torch.cuda.get_device_name(device)}}" if device.type == "cuda" else "")

log.info("Loading model %r ...", model_name)
t0 = time.perf_counter()
model = load_model(
    model_name,
    mlflow_version=mlflow_version,
    mlflow_tracking_uri=os.environ.get("EMBLASE_MLFLOW_TRACKING_URI") or None,
    mlflow_api_key=os.environ.get("EMBLASE_MLFLOW_API_KEY") or None,
)
log.info("Model loaded in %.1f s", time.perf_counter() - t0)

# ---------------------------------------------------------------------------
# Projector approximator
# ---------------------------------------------------------------------------
_projector_model = _projector_scaler = None

if projector_mode == "name":
    try:
        _projector_model, _projector_scaler = load_projector(projector_name, models_dir, device)
    except Exception as _exc:
        log.warning("Projector not loaded — projections will be NaN: %s", _exc)


def _compute_projections(embeddings: np.ndarray) -> np.ndarray | None:
    if projector_mode == "false" or _projector_model is None:
        return None
    X = embeddings.astype("float32")
    if _projector_scaler is not None:
        X = _projector_scaler.transform(X)
    with torch.no_grad():
        return _projector_model(
            torch.tensor(X, dtype=torch.float32, device=device)
        ).cpu().numpy().astype("float32")


# ---------------------------------------------------------------------------
# Classifier
# ---------------------------------------------------------------------------
_classifier_dir = None

if classifier_name:
    try:
        _classifier_dir = load_classifier_dir(classifier_name, models_dir)
    except Exception as _exc:
        log.warning("Classifier not loaded — labels will be null: %s", _exc)

# ---------------------------------------------------------------------------
# Tiled client
# ---------------------------------------------------------------------------
tiled_client = None
if run_path or inputs or output:
    from tiled.client import from_uri  # noqa: E402
    tiled_server = os.environ["EMBLASE_TILED_SERVER_URI"]
    log.info("Connecting to Tiled: %s", tiled_server)
    tiled_client = from_uri(tiled_server, api_key=os.environ.get("EMBLASE_TILED_API_KEY") or None)

# ---------------------------------------------------------------------------
# Load input frames
# ---------------------------------------------------------------------------
images = None
frame_entries = None
frame_indices: list[int] = []

if run_path:
    from emblase.tiled.client import read_images  # noqa: E402
    run_segments = [s for s in run_path.split("/") if s]
    run_node = tiled_client[tuple(run_segments)]
    run_key = run_segments[-1] if run_segments else ""
    image_tiled_path = run_path.rstrip("/") + f"/{{image_stream}}/{{image_array_key}}"
    log.info("Reading frames from %s", image_tiled_path)
    t0 = time.perf_counter()
    images, frame_entries = read_images(tiled_client, [image_tiled_path])
    frame_indices = list(range(len(images)))
    log.info("Read %d frame(s) in %.1f s", len(images), time.perf_counter() - t0)

elif inputs:
    from emblase.tiled.client import read_images  # noqa: E402
    run_key = ""
    log.info("Reading %d Tiled entr%s ...", len(inputs), "y" if len(inputs) == 1 else "ies")
    t0 = time.perf_counter()
    images, frame_entries = read_images(tiled_client, inputs)
    frame_indices = list(range(len(images)))
    log.info("Read %d frame(s) in %.1f s  shapes=%s",
             len(images), time.perf_counter() - t0,
             sorted({{img.shape for img in images}}))

else:
    input_path = os.path.join(job_dir, "input.npy")
    run_key = ""
    log.info("Loading %s ...", input_path)
    arr = np.load(input_path)
    if arr.ndim == 3:
        arr = arr[:, np.newaxis]
    images = torch.from_numpy(arr).float()
    frame_indices = list(range(len(images)))
    log.info("Loaded: shape=%s  dtype=%s", arr.shape, arr.dtype)

# ---------------------------------------------------------------------------
# Load param arrays (run-path mode only)
# ---------------------------------------------------------------------------
batch_params: dict | None = None

if param_specs and run_path:
    try:
        _stream_cache: dict = {{}}
        raw_params: dict[str, np.ndarray] = {{}}
        for name, spec in param_specs.items():
            source = spec.get("source", "")
            parts = source.split("/", 1)
            if len(parts) != 2:
                log.warning("Param %r: invalid source %r (expected 'stream/key') — skipping", name, source)
                continue
            sname, akey = parts
            if sname not in _stream_cache:
                _stream_cache[sname] = run_node[sname]
            raw_params[name] = np.asarray(_stream_cache[sname][akey].read())
            log.info("Loaded param %r from %s  shape=%s", name, source, raw_params[name].shape)
        batch_params = {{
            name: [raw_params[name][i].item() for i in frame_indices]
            for name in param_specs if name in raw_params
        }}
    except Exception as exc:
        log.exception("Failed to load param arrays — params will be null: %s", exc)

elif param_specs:
    log.warning("param_specs provided but run_path is empty — params require run_path mode")

# ---------------------------------------------------------------------------
# Encode
# ---------------------------------------------------------------------------
log.info("Encoding (batch_size=%d) ...", batch_size)
t0 = time.perf_counter()
embeddings = encode(model, images, batch_size=batch_size)
log.info("Encoded in %.1f s  shape=%s", time.perf_counter() - t0, embeddings.shape)

# ---------------------------------------------------------------------------
# Projections
# ---------------------------------------------------------------------------
projections = None
if projector_mode == "scratch":
    log.info("Fitting UMAP from scratch over %d embeddings ...", len(embeddings))
    try:
        import umap as _umap  # noqa: PLC0415
        projections = _umap.UMAP(n_components=2, random_state=42).fit_transform(
            embeddings.astype("float32")
        ).astype("float32")
        log.info("Scratch UMAP done: %s", projections.shape)
    except Exception as _exc:
        log.warning("Scratch UMAP failed — projections will be NaN: %s", _exc)
elif projector_mode == "false":
    log.info("Projector disabled — projections will be NaN")
else:
    projections = _compute_projections(embeddings)

# ---------------------------------------------------------------------------
# Classifier labels
# ---------------------------------------------------------------------------
_classifier_labels: list[str] | None = None
if _classifier_dir is not None:
    try:
        from emblase.classifier import apply_classifier  # noqa: E402
        _classifier_labels = list(apply_classifier(embeddings, classifier_dir=_classifier_dir))
        log.info("Classifier: %d unique labels", len(set(_classifier_labels)))
    except Exception as _exc:
        log.warning("Classifier failed — labels will be null: %s", _exc)

# ---------------------------------------------------------------------------
# Save / write output
# ---------------------------------------------------------------------------
if not output:
    output_path = os.path.join(job_dir, "output.npy")
    np.save(output_path, embeddings)
    log.info("output.npy saved: %s", output_path)

if output:
    from emblase.tiled.client import write_output  # noqa: E402
    log.info("Writing to Tiled: %s  shape=%s", output, embeddings.shape)
    t0 = time.perf_counter()
    resolved = write_output(
        tiled_client, output, embeddings,
        images=images if isinstance(images, list) else None,
        source_entries=frame_entries,
        run_key=run_key, mode="batch",
        model_name=model_name,
        thumb_mode=thumb_mode,
        access_tags=access_tags,
        params=batch_params,
        param_specs=param_specs if batch_params is not None else None,
        projections=projections,
        labels=_classifier_labels,
    )
    log.info("Written to Tiled: %s  (%.1f s)", resolved, time.perf_counter() - t0)

log.info("=== Done ===")
