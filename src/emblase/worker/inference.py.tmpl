"""Inference script — runs on the compute node inside `pixi run python`.

Filled by _render_inference_script():
    {models_dir}     — absolute path to the models directory on the compute node
    {model_name}     — short name ("vae", "vit") or MLflow registry name
    {batch_size}     — number of images per encode call (default 1)
    {inputs}         — repr of list[str | tuple[str,str]] of Tiled (path[, slice]) entries
    {output}         — Tiled container path to write embeddings (empty → save output.npy only)
    {mlflow_version} — MLflow model version, or "" for latest

job_dir is read from the JOB_DIR environment variable (set by the sbatch script
to working_dir/job_$SLURM_JOB_ID), so the folder name always matches slurm-<id>.out.

Input source (controlled by inputs):
  - non-empty — read frames from Tiled via read_images.
  - empty      — load input.npy from job_dir (embedded or symlinked by sbatch).

Output delivery (controlled by output):
  - non-empty  — write embeddings into the Tiled container at output path.
  - empty      — save output.npy in job_dir only.
"""

import logging
import os
import sys
import time

import numpy as np
import torch

# --- logging setup ---
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
    stream=sys.stdout,
    force=True,
)
log = logging.getLogger("emblase.inference")

# --- job parameters (substituted by _render_inference_script) ---
job_dir = os.environ["JOB_DIR"]
model_name = "{model_name}"
batch_size = {batch_size}
inputs = {inputs}
output = "{output}"
mlflow_version = "{mlflow_version}" or None

# access_tags: comma-separated string from env → list[str], or None if unset/empty
_raw_tags = os.environ.get("EMBLASE_TILED_ACCESS_TAGS", "").strip()
access_tags: list[str] | None = [t.strip() for t in _raw_tags.split(",") if t.strip()] or None

log.info("=== Emblase inference job ===")
log.info("job_dir    : %s", job_dir)
log.info("model      : %s", model_name)
log.info("mlflow_ver : %s", mlflow_version or "latest")
log.info("batch_size : %d", batch_size)
log.info("inputs     : %s", inputs or "(none — loading input.npy)")
log.info("output     : %s", output or "(none — saving output.npy)")
log.info("access_tags: %s", access_tags or "(none — server default)")

# Ensure the models directory is on sys.path so model source files are importable.
models_dir = "{models_dir}"
if models_dir not in sys.path:
    sys.path.insert(0, models_dir)

from emblase.models import encode, load_model  # noqa: E402

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
log.info("device     : %s", device)
if device.type == "cuda":
    log.info("GPU        : %s", torch.cuda.get_device_name(device))

# --- load model ---
log.info("Loading model %r ...", model_name)
t0 = time.perf_counter()
model = load_model(
    model_name,
    mlflow_version=mlflow_version,
    mlflow_tracking_uri=os.environ.get("EMBLASE_MLFLOW_TRACKING_URI") or None,
    mlflow_api_key=os.environ.get("EMBLASE_MLFLOW_API_KEY") or None,
)
log.info("Model loaded in %.1f s", time.perf_counter() - t0)

# --- load input ---
tiled_client = None
if inputs:
    from tiled.client import from_uri
    from emblase.tiled.client import read_images  # noqa: E402

    tiled_server = os.environ["EMBLASE_TILED_SERVER_URI"]
    log.info("Connecting to Tiled: %s", tiled_server)
    tiled_client = from_uri(
        tiled_server,
        api_key=os.environ.get("EMBLASE_TILED_API_KEY") or None,
    )
    log.info("Reading %d Tiled entr%s ...", len(inputs), "y" if len(inputs) == 1 else "ies")
    t0 = time.perf_counter()
    images = read_images(tiled_client, inputs)
    unique_shapes = sorted(set(img.shape for img in images))
    log.info(
        "Read %d frame(s) in %.1f s  (shapes: %s)",
        len(images),
        time.perf_counter() - t0,
        unique_shapes,
    )
else:
    input_path = os.path.join(job_dir, "input.npy")
    log.info("Loading input from %s ...", input_path)
    arr = np.load(input_path)
    log.info("Loaded array: shape=%s  dtype=%s", arr.shape, arr.dtype)
    if arr.ndim == 3:
        arr = arr[:, np.newaxis, :, :]
        log.info("Reshaped to (N, 1, H, W): %s", arr.shape)
    images = torch.from_numpy(arr).float()

# --- encode ---
log.info("Encoding (batch_size=%d) ...", batch_size)
t0 = time.perf_counter()
embeddings = encode(model, images, batch_size=batch_size)
log.info("Encoded in %.1f s  →  shape: %s", time.perf_counter() - t0, embeddings.shape)

# --- save output.npy (always) ---
output_path = os.path.join(job_dir, "output.npy")
np.save(output_path, embeddings)
log.info("output.npy saved: %s", output_path)

# --- write to Tiled if output path given ---
if output:
    from tiled.client import from_uri
    from emblase.tiled.client import write_output  # noqa: E402

    if tiled_client is None:
        tiled_server = os.environ["EMBLASE_TILED_SERVER_URI"]
        log.info("Connecting to Tiled for output: %s", tiled_server)
        tiled_client = from_uri(
            tiled_server,
            api_key=os.environ.get("EMBLASE_TILED_API_KEY") or None,
        )
    log.info("Writing embeddings to Tiled: %s  shape=%s", output, embeddings.shape)
    t0 = time.perf_counter()
    write_output(
        tiled_client,
        output,
        embeddings,
        images=images if isinstance(images, list) else None,
        source_entries=inputs or None,
        model_name=model_name,
        access_tags=access_tags,
    )
    log.info("Written to Tiled in %.1f s", time.perf_counter() - t0)

log.info("=== Done ===")
