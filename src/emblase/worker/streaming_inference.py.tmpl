"""Streaming inference script — runs on the compute node inside `pixi run python`.

Filled by _render_streaming_inference_script():
    {{models_dir}}       — absolute path to the models directory on the compute node
    {{model_name}}       — short name ("vae", "vit") or MLflow registry name
    {{batch_size}}       — number of frames per encode call
    {{run_path}}         — Tiled path to the BlueskyRun to watch
    {{output}}           — Tiled path to write embeddings.  Behaviour:
                           • path is an LSE container → append to it;
                           • path doesn't exist        → create LSE there;
                           • path is a non-LSE parent  → create {{run_key}}_stream_{{ts}} inside it.
    {{mlflow_version}}   — MLflow model version, or "" for latest
    {{thumb_mode}}       — thumbnail mode ("default" or "logroi")
    {{image_key}}        — slash-separated key of the image array, e.g. "primary/pil900KW_image"
    {{ws_max_size}}      — WebSocket max message size in bytes
    {{param_specs_json}} — JSON dict mapping param name → ParamSpec
    {{projector_mode}}   — one of: "name" | "scratch" | "false"
    {{projector_name}}   — projector model name when projector_mode=="name", else ""
    {{classifier_name}}  — classifier model name, or "" to skip classification

Projector behaviour:
    projector_mode="name"    — resolve saved approximator; apply per-batch.
    projector_mode="scratch" — accumulate all embeddings; fit UMAP after stop-doc; rewrite.
    projector_mode="false"   — skip; write NaN projections.

Flow:
  1. Load model, projector, classifier.
  2. Subscribe to run → wait for image stream → subscribe to image array.
  3. Accumulate frames; enqueue full batches to the writer thread.
  4. Subscribe to parent container → detect stop document.
  5. On stop doc: wait for WS to settle, flush remainder, send sentinel to writer.
  6. Optionally fit scratch UMAP and rewrite projections.
"""

import json
import logging
import os
import queue
import sys
import threading
import time

import numpy as np
import torch

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
    stream=sys.stdout,
    force=True,
)
log = logging.getLogger("emblase.streaming_inference")

# --- job parameters (substituted at render time) ---
job_dir         = os.environ["JOB_DIR"]
model_name      = "{model_name}"
batch_size      = {batch_size}
run_path        = "{run_path}"
output          = "{output}"
mlflow_version  = "{mlflow_version}" or None
thumb_mode      = "{thumb_mode}"
image_key       = "{image_key}"
ws_max_size     = {ws_max_size}
param_specs     = json.loads('{param_specs_json}')
projector_mode  = "{projector_mode}"
projector_name  = "{projector_name}"
classifier_name = "{classifier_name}"
models_dir      = "{models_dir}"

# Resolve image_key → (stream, array_key)
_ik = image_key.split("/", 1)
image_stream    = _ik[0] if len(_ik) == 2 else "primary"
image_array_key = _ik[1] if len(_ik) == 2 else _ik[0]

_raw_tags = os.environ.get("EMBLASE_TILED_ACCESS_TAGS", "").strip()
access_tags: list[str] | None = [t.strip() for t in _raw_tags.split(",") if t.strip()] or None

log.info("=== Emblase streaming inference job ===")
log.info("job_dir    : %s", job_dir)
log.info("model      : %s  ver=%s", model_name, mlflow_version or "latest")
log.info("run_path   : %s", run_path)
log.info("output     : %s", output)
log.info("batch_size : %d  thumb_mode=%s", batch_size, thumb_mode)
log.info("image_key  : %s  (stream=%r  array=%r)", image_key, image_stream, image_array_key)
log.info("access_tags: %s", access_tags)
log.info("param_specs: %s", list(param_specs.keys()))
log.info("projector  : mode=%s  name=%r", projector_mode, projector_name or "(n/a)")
log.info("classifier : %s", classifier_name or "(none)")

if models_dir not in sys.path:
    sys.path.insert(0, models_dir)

from emblase.models import encode, load_model  # noqa: E402
from emblase.worker.utils import load_classifier_dir, load_projector  # noqa: E402

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
log.info("device: %s%s", device, f"  GPU={{torch.cuda.get_device_name(device)}}" if device.type == "cuda" else "")

log.info("Loading model %r ...", model_name)
t0 = time.perf_counter()
model = load_model(
    model_name,
    mlflow_version=mlflow_version,
    mlflow_tracking_uri=os.environ.get("EMBLASE_MLFLOW_TRACKING_URI") or None,
    mlflow_api_key=os.environ.get("EMBLASE_MLFLOW_API_KEY") or None,
)
log.info("Model loaded in %.1f s", time.perf_counter() - t0)

# ---------------------------------------------------------------------------
# Projector approximator
# ---------------------------------------------------------------------------
_projector_model = _projector_scaler = None

if projector_mode == "name":
    try:
        _projector_model, _projector_scaler = load_projector(projector_name, models_dir, device)
    except Exception as _exc:
        log.exception("Projector not loaded — projections will be NaN: %s", _exc)


def _compute_projections(embeddings: np.ndarray) -> np.ndarray | None:
    if _projector_model is None:
        return None
    X = embeddings.astype("float32")
    if _projector_scaler is not None:
        X = _projector_scaler.transform(X)
    with torch.no_grad():
        return _projector_model(
            torch.tensor(X, dtype=torch.float32, device=device)
        ).cpu().numpy().astype("float32")


# ---------------------------------------------------------------------------
# Classifier
# ---------------------------------------------------------------------------
_classifier_dir = None

if classifier_name:
    try:
        _classifier_dir = load_classifier_dir(classifier_name, models_dir)
    except Exception as _exc:
        log.exception("Classifier not loaded — labels will be null: %s", _exc)

# ---------------------------------------------------------------------------
# Tiled
# ---------------------------------------------------------------------------
from tiled.client import from_uri  # noqa: E402
from emblase.tiled.client import write_output  # noqa: E402

tiled_server = os.environ["EMBLASE_TILED_SERVER_URI"]
log.info("Connecting to Tiled: %s", tiled_server)
tiled_client = from_uri(tiled_server, api_key=os.environ.get("EMBLASE_TILED_API_KEY") or None)

run_segments = [s for s in run_path.split("/") if s]
run_node = tiled_client[tuple(run_segments)]
run_key = run_segments[-1] if run_segments else ""

# ---------------------------------------------------------------------------
# Param arrays — loaded lazily once the image array appears.
# ---------------------------------------------------------------------------
_param_arrays: dict[str, np.ndarray] = {{}}
_param_arrays_ready = threading.Event()


def _load_param_arrays() -> None:
    if not param_specs:
        _param_arrays_ready.set()
        return
    try:
        for name, spec in param_specs.items():
            source = spec.get("source", "")
            parts = source.split("/", 1)
            if len(parts) != 2:
                log.warning("Param %r: invalid source %r (expected 'stream/key') — skipping", name, source)
                continue
            sname, akey = parts
            arr = run_node[sname][akey].read()
            _param_arrays[name] = np.asarray(arr)
            log.info("Loaded param %r shape=%s", name, _param_arrays[name].shape)
    except Exception as exc:
        log.exception("Failed to load param arrays: %s", exc)
    finally:
        _param_arrays_ready.set()


# ---------------------------------------------------------------------------
# Scratch-UMAP accumulator
# ---------------------------------------------------------------------------
_all_embeddings: list[np.ndarray] = []
_all_embeddings_lock = threading.Lock()

# ---------------------------------------------------------------------------
# Writer thread
# ---------------------------------------------------------------------------
_write_queue: queue.Queue = queue.Queue()
_done = threading.Event()
_writer_error: BaseException | None = None
_resolved_output: list[str] = []  # set on first write; list used for thread-safe assignment


def _writer_loop() -> None:
    global _writer_error
    try:
        while True:
            item = _write_queue.get()
            try:
                if item is None:
                    log.info("Writer thread: sentinel received — exiting")
                    return
                frames, entries, frame_indices = item
                t0 = time.perf_counter()
                embeddings = encode(model, frames, batch_size=1)
                log.info("Encoded %d frame(s) in %.1f s  shape=%s",
                         len(frames), time.perf_counter() - t0, embeddings.shape)

                if projector_mode == "scratch":
                    with _all_embeddings_lock:
                        _all_embeddings.append(embeddings.copy())
                    projections = None
                elif projector_mode == "name":
                    projections = _compute_projections(embeddings)
                else:
                    projections = None

                batch_labels = None
                if _classifier_dir is not None:
                    try:
                        from emblase.classifier import apply_classifier  # noqa: PLC0415
                        batch_labels = list(apply_classifier(embeddings, classifier_dir=_classifier_dir))
                    except Exception as _exc:
                        log.warning("Classifier failed for batch: %s", _exc)

                batch_params = None
                if param_specs:
                    _param_arrays_ready.wait(timeout=30)
                    if _param_arrays:
                        batch_params = {{
                            name: (
                                [_param_arrays[name][i].item() for i in frame_indices]
                                if name in _param_arrays else [None] * len(frame_indices)
                            )
                            for name in param_specs
                        }}

                resolved = write_output(
                    tiled_client, output, embeddings,
                    images=frames, source_entries=entries,
                    run_key=run_key, mode="stream",
                    model_name=model_name, thumb_mode=thumb_mode, access_tags=access_tags,
                    params=batch_params,
                    param_specs=param_specs if batch_params is not None else None,
                    projections=projections,
                    labels=batch_labels,
                )
                if not _resolved_output:
                    _resolved_output.append(resolved)
                    log.info("Output container: %s", resolved)
                log.info("Written to Tiled: %s", resolved)
            finally:
                _write_queue.task_done()
    except Exception as exc:
        _writer_error = exc
        log.exception("Writer thread failed: %s", exc)
    finally:
        _done.set()


threading.Thread(target=_writer_loop, name="emblase-writer", daemon=True).start()

# ---------------------------------------------------------------------------
# Frame accumulation
# ---------------------------------------------------------------------------
_lock = threading.Lock()
_queued_frames: list[np.ndarray] = []
_queued_entries: list[tuple] = []
_queued_indices: list[int] = []
_next_frame_idx = 0


def _maybe_flush_batch() -> None:
    """Drain queue to writer when it reaches batch_size. Must be called with _lock held."""
    if len(_queued_frames) >= batch_size:
        _write_queue.put((list(_queued_frames), list(_queued_entries), list(_queued_indices)))
        _queued_frames.clear()
        _queued_entries.clear()
        _queued_indices.clear()


def _on_new_image_data(event) -> None:
    global _next_frame_idx
    chunk = event.data()
    n = chunk.shape[0]
    log.info("Received %d frame(s) (idx %d–%d)", n, _next_frame_idx, _next_frame_idx + n - 1)
    with _lock:
        for i in range(n):
            _queued_frames.append(chunk[i].squeeze())
            _queued_entries.append(
                (run_path + f"/{{image_stream}}/{{image_array_key}}", str(_next_frame_idx))
            )
            _queued_indices.append(_next_frame_idx)
            _next_frame_idx += 1
        _maybe_flush_batch()


def _on_image_child_created(event) -> None:
    if event.key == image_array_key:
        log.info("Image array %r appeared — subscribing", image_array_key)
        threading.Thread(target=_load_param_arrays, name="emblase-params", daemon=True).start()
        sub = event.child().subscribe()
        sub.new_data.add_callback(_on_new_image_data)
        _all_subs.append(sub)
        sub.start_in_thread(start=1, max_size=ws_max_size)


def _on_run_child_created(event) -> None:
    if event.key == image_stream:
        log.info("%r stream appeared — subscribing", image_stream)
        sub = event.child().subscribe()
        sub.child_created.add_callback(_on_image_child_created)
        _all_subs.append(sub)
        sub.start_in_thread(start=1)


def _on_stop_doc(event) -> None:
    if event.key != run_segments[-1] or "stop" not in (event.metadata or {{}}):
        return
    log.info("Stop doc received — waiting for image WS to settle")
    _STABLE_SECS, _MAX_WAIT_SECS = 2.0, 120.0
    deadline = time.monotonic() + _MAX_WAIT_SECS
    last_idx, stable_since = -1, time.monotonic()
    while time.monotonic() < deadline:
        time.sleep(0.2)
        with _lock:
            cur = _next_frame_idx
        if cur != last_idx:
            last_idx, stable_since = cur, time.monotonic()
        elif time.monotonic() - stable_since >= _STABLE_SECS:
            break
    log.info("Settled at %d frame(s) — flushing remainder", last_idx)
    with _lock:
        remaining = list(_queued_frames), list(_queued_entries), list(_queued_indices)
        _queued_frames.clear()
        _queued_entries.clear()
        _queued_indices.clear()
    if remaining[0]:
        log.info("Flushing %d remaining frame(s)", len(remaining[0]))
        _write_queue.put(remaining)
    _write_queue.put(None)


# ---------------------------------------------------------------------------
# Subscribe
# ---------------------------------------------------------------------------
_all_subs: list = []

run_sub = run_node.subscribe()
run_sub.child_created.add_callback(_on_run_child_created)
_all_subs.append(run_sub)
run_sub.start_in_thread(start=1)

parent_node = tiled_client[tuple(run_segments[:-1])]
parent_sub = parent_node.subscribe()
parent_sub.child_metadata_updated.add_callback(_on_stop_doc)
_all_subs.append(parent_sub)
parent_sub.start_in_thread(start=1)

log.info("Watching run %s — waiting for stop document ...", run_path)

_done.wait(timeout=7200)

if not _done.is_set():
    log.warning("Timeout — flushing and exiting")
    with _lock:
        remaining = list(_queued_frames), list(_queued_entries), list(_queued_indices)
        _queued_frames.clear()
        _queued_entries.clear()
        _queued_indices.clear()
    if remaining[0]:
        _write_queue.put(remaining)
    _write_queue.put(None)
    _write_queue.join()

for sub in _all_subs:
    try:
        sub.disconnect()
    except Exception:
        pass

# ---------------------------------------------------------------------------
# Scratch projector — fit over all accumulated embeddings.
# ---------------------------------------------------------------------------
if projector_mode == "scratch" and not _writer_error:
    with _all_embeddings_lock:
        _collected = _all_embeddings[:]
    if _collected:
        _all_emb = np.vstack(_collected)
        log.info("Fitting scratch UMAP over %d embeddings ...", len(_all_emb))
        try:
            import umap as _umap  # noqa: PLC0415
            _proj = _umap.UMAP(n_components=2, random_state=42).fit_transform(
                _all_emb.astype("float32")
            ).astype("float32")
            log.info("Scratch UMAP done: %s", _proj.shape)
            _out_path = _resolved_output[0] if _resolved_output else output
            _out_segs = [s for s in _out_path.split("/") if s]
            tiled_client[tuple(_out_segs)]["projections"].write(_proj)
            log.info("Projections written to %s/projections", _out_path)
        except Exception as _exc:
            log.warning("Scratch UMAP failed — projections remain NaN: %s", _exc)
    else:
        log.warning("No embeddings collected — scratch UMAP skipped")

log.info("=== Streaming inference done ===")

if _writer_error:
    log.error("Exiting with error due to writer thread failure")
    sys.exit(1)
