"""Inference script — runs on the compute node inside `pixi run python`.

Filled by _render_inference_script():
    {models_dir}        — absolute path to the models directory on the compute node
    {model_name}        — "vae" or "vit"
    {latent_dim}        — integer latent dimension
    {image_size}        — tuple like (512, 512)
    {output_mode}       — "none" | "tiled"
    {tiled_result_path} — path within the Tiled server to write results (tiled mode only)

job_dir is read from the JOB_DIR environment variable (set by the sbatch script
to working_dir/job_$SLURM_JOB_ID), so the folder name always matches slurm-<id>.out.

Output delivery (controlled by output_mode):
  - "none"  — save output.npy on the node only.
  - "tiled" — write the output array into a Tiled collection at
              $EMBLASE_TILED_URI/{tiled_result_path} using $EMBLASE_TILED_API_KEY.
"""

import os
import sys

import numpy as np
import torch

job_dir = os.environ["JOB_DIR"]
model_name = "{model_name}"
latent_dim = {latent_dim}
image_size = {image_size}
output_mode = "{output_mode}"
tiled_result_path = "{tiled_result_path}"

# Ensure the models directory is on sys.path so vae/vae.py and vit/vit.py are importable.
models_dir = "{models_dir}"
if models_dir not in sys.path:
    sys.path.insert(0, models_dir)

from emblase.models import encode, load_model  # noqa: E402

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Device: {{device}}")

model = load_model(model_name, latent_dim=latent_dim, image_size=image_size)

# --- load input ---
input_path = os.path.join(job_dir, "input.npy")
images = np.load(input_path)
if images.ndim == 3:
    images = images[:, np.newaxis, :, :]
tensor = torch.from_numpy(images).float().to(device)
print(f"Input: {{tensor.shape}}")

# --- encode ---
output = encode(model, tensor, model_name)
print(f"Output: {{output.shape}}")

# --- save output.npy (always) ---
output_path = os.path.join(job_dir, "output.npy")
np.save(output_path, output)
print(f"Output saved: {{output_path}}")

# --- deliver results ---
if output_mode == "tiled":
    from tiled.client import from_uri  # noqa: E402

    tiled_uri = os.environ.get("EMBLASE_TILED_URI", "")
    api_key = os.environ.get("EMBLASE_TILED_API_KEY") or None
    if not tiled_uri:
        print("WARNING: EMBLASE_TILED_URI not set — skipping Tiled write")
    else:
        client = from_uri(tiled_uri, api_key=api_key)
        node = client
        for part in tiled_result_path.strip("/").split("/"):
            node = node[part]
        node.write(output)
        print(f"Written to Tiled: {{tiled_uri}}/{{tiled_result_path}}")
