# Orion API key
EMBLASE_ORION_API_KEY=

# Orion job config — absolute paths (Slurm does not expand ~)
EMBLASE_ORION_WORKING_DIR=/nsls2/users/<username>/code/emblase/jobs
EMBLASE_ORION_PROJECT_DIR=/nsls2/users/<username>/code/emblase
EMBLASE_ORION_HOME=/nsls2/users/<username>
# EMBLASE_ORION_CLUSTER=orion
# EMBLASE_ORION_ACCOUNT=staff
# EMBLASE_ORION_PATH=/usr/bin:/usr/local/bin:/nsls2/software/bin

# Tiled server config
EMBLASE_TILED_SERVER_URI=https://tiled.nsls2.bnl.gov
EMBLASE_TILED_API_KEY=

# MLflow settings — AmSC
EMBLASE_MLFLOW_TRACKING_URI=https://mlflow.american-science-cloud.org
EMBLASE_MLFLOW_API_KEY=
# EMBLASE_MLFLOW_EXPERIMENT=emblase-models

# MLflow settings — AmSC staging (uncomment to use)
# EMBLASE_MLFLOW_TRACKING_URI=https://mlflow-staging.american-science-cloud.org
# EMBLASE_MLFLOW_API_KEY=

# MLflow settings — Azure ML (uncomment to use; no API key needed, uses az login)
# EMBLASE_MLFLOW_TRACKING_URI=azureml://<region>.api.azureml.ms/mlflow/v1.0/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>

# Shared models directory — used for both manually uploaded local models and the
# MLflow artifact cache.  Must be an absolute writable path on the compute node.
# On Orion: use persistent NFS (no purge):
#   EMBLASE_MODELS_DIR=/nsls2/users/<username>/code/emblase/models
# On NERSC: use /pscratch (fast Lustre, writable inside the container; 30-day purge):
#   EMBLASE_MODELS_DIR=/pscratch/sd/<initial>/<username>/emblase/models
# Set to whichever backend you are targeting (or the NERSC path if using both,
# since that is the path the container sees at runtime):
EMBLASE_MODELS_DIR=/pscratch/sd/<initial>/<username>/emblase/models

# NERSC IRI API settings
EMBLASE_NERSC_API_URI=https://api.iri.nersc.gov
EMBLASE_NERSC_API_TOKEN=
EMBLASE_NERSC_RESOURCE_ID=perlmutter
EMBLASE_NERSC_WORKING_DIR=/pscratch/sd/<initial>/<username>/emblase/jobs
# GPU allocation account — append _g suffix for GPU jobs on Perlmutter
EMBLASE_NERSC_ACCOUNT=<project>_g
EMBLASE_NERSC_CONTAINER_IMAGE=ghcr.io/genematx/emblase:latest
EMBLASE_NERSC_TIME_LIMIT=00:30:00
# Queue/partition. "shared" (shared_gpu_ss11) dispatches single-GPU jobs fastest.
# Use "debug" for quick tests (≤30 min cap). Leave empty to let scheduler pick.
EMBLASE_NERSC_QUEUE=shared
# EMBLASE_NERSC_CONSTRAINT=

# NERSC secrets file — absolute path to a chmod 600 file on Perlmutter that
# holds Tiled/MLflow credentials for jobs running inside the container.
#
# Perlmutter home directory path: /global/u2/<first_letter>/<username>
# (e.g. /global/u2/j/jdoe — confirm with: python scripts/submit_nersc.py ls /global/u2/j/jdoe)
#
# $HOME (/global/u2/...) is bind-mounted read-only inside podman-hpc containers.
# Create the file once using the CLI (reads credentials from this .env file):
#
#   python scripts/submit_nersc.py secrets \
#       --path /global/u2/j/jdoe/.emblase_secrets
#
# The file will contain lines like:
#   EMBLASE_TILED_SERVER_URI='https://tiled.nsls2.bnl.gov'
#   EMBLASE_TILED_API_KEY='<your-tiled-key>'
#   EMBLASE_MLFLOW_TRACKING_URI='https://mlflow.american-science-cloud.org'
#   EMBLASE_MLFLOW_API_KEY='<your-mlflow-key>'
#
# Override the path read by inference jobs (default: ~/.emblase_secrets):
# EMBLASE_NERSC_SECRETS_FILE=/global/u2/j/jdoe/.emblase_secrets
